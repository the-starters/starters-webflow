.DS_Store

# Local-only demo pages & test harnesses — never commit.
local-demos/

# Local agent-skills mirror of the tracked .claude/skills (created by the
# skills distribution tooling) — never commit.
.agents/

# Credentials and captured sessions. The staging-qa harness lives OUTSIDE this
# repo (../staging-qa/), so these rules are a second line of defence only: they
# exist so that a script dropped in here by mistake still cannot publish a
# secret to a public, CDN-served repo.
.env
.env.*
!.env.example
storage-state*.json
.auth/
node_modules/

# Proposed-record dumps from scripts/learn-reindex.mjs. Local only.
scripts/.learn-reindex-out/

# Ephemeral Chrome user-data directories created by
# v3/browser-tests/call-settings-receipt.browser.cjs and
# v3/browser-tests/work-experience-annotations.browser.cjs (mkdtemp in the
# repository root). Normally removed on exit; ignored so a crashed run cannot
# commit a browser profile.
.call-receipt-browser-*/
.work-experience-browser-*/
