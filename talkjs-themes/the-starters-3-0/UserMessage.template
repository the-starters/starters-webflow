<!--
Renders a message sent by a user.
-->
<template>
    <div class="message-row {{ sender.isMe | then: 'by-me' | else: 'by-other' }} {{ body.type }} {{ sender.id == previousSenderId | then: 'previous-same' }}">

        <!-- show the avatar, but only if the previous message was by a different sender -->
        <t:set t:if="{{ previousMessage and previousMessage.sender }}" previousSenderId="{{ previousMessage.sender.id }}"/>
        <t:set showAvatar="{{ sender.id != previousSenderId }}"/>

        <!-- Clickable Identity. The other participant's avatar is an action
             button carrying their Memberstack id; the Messages controller
             resolves that id to /hire/[slug] and opens it in a new tab
             (nothing happens for members without a profile page). Your own
             avatar stays a plain Avatar — no button, no affordance, because a
             link to your own profile is pointless. The two branches are
             separate t:if tests rather than an if/else chain so neither
             depends on the other's adjacency.

             The button wraps only an Avatar, which is an empty div painted
             with a background-image, so on its own it is a tab stop that
             screen readers announce as an unnamed "button". The hidden span
             is its accessible name — the same mechanism that already names
             the header's name button, which has real text inside it. -->
        <ActionButton t:if="{{ showAvatar and sender.isMe == false }}"
            class="identity-avatar"
            action="starters-open-profile"
            data-member="{{ sender.id }}">
            <Avatar photoUrl="{{ sender.photoUrl }}"/>
            <span class="visually-hidden">View {{ sender.name }}'s profile</span>
        </ActionButton>
        <Avatar t:if="{{ showAvatar and sender.isMe == true }}"
            photoUrl="{{ sender.photoUrl }}"
        />

        <t:set showAuthor="{{ sender.isMe == false and conversation.isGroupChat }}" />
        <div class="message {{ body.hasThumbnail | then: 'has-thumbnail' }}  {{ showAuthor | then: 'has-author' }} {{hasLinkPreviews | then: 'has-link-previews'}}">

            <ActionMenu class="action-menu"><Icon type="horizontalDots" /></ActionMenu>

            <!-- in group chats, show the message sender name in a random color -->
            <div t:if="{{ showAuthor }}"
                 class="message-author"
                 style="color: {{ sender.id | random_color }}">
                {{ sender.name }}
            </div>

            <!-- When there's no author name shown, the action menu icon may appear on top of any media previews in the message body, so darken the area below it. -->
            <t:set darkenMenuArea="{{ showAuthor | then: false | else: showActionMenu }}" />
            <MessageBody
                body="{{ body }}"
                timestamp="{{ timestamp }}"
                floatTimestamp="auto"
                showStatus="{{ sender.isMe }}"
                isLongEmailMessage="{{isLongEmailMessage}}"
                darkenMenuArea="{{ darkenMenuArea }}"
                referencedMessage="{{ referencedMessage }}"
            />
        </div>
    </div>

    <div t:if="{{ reactions and reactions.length > 0 }}" class="emoji-reactions {{ sender.isMe | then: 'by-me' | else: 'by-other' }}">
        <EmojiReactionButton t:for="{{ reaction in reactions }}" t:key="{{ reaction.emoji }}" class="emoji-reaction {{ reaction.iReacted | then: 'i-reacted' }}" reaction="{{ reaction }}">
            <span class="reaction"><Emoji emoji="{{ reaction.emoji }}"/></span>
            <span class="num-reactions" t:if="{{ reaction.numReactions > 1 }}">{{ reaction.numReactions }}</span>
        </EmojiReactionButton>

        <AddEmojiReaction class="add-emoji-reaction" t:if="{{ canReact }}">
            <Icon type="addEmoji" class="icon" />
        </AddEmojiReaction>
    </div>
</template>
