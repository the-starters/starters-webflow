<!--
This is a subcomponent used by UserMessage and SystemMessage.
-->
<template>

    <!-- One predicate for both halves of the timestamp: the class that reserves
         the band, and the branch that renders the band's contents. Written out
         twice they agreed today but could silently drift — insert any branch
         between the typing-indicator t:if and its t:else and the timestamp
         would paint over the message text with no reservation under it. -->
    <t:set hasTimestamp="{{ body.type != 'typing-indicator' }}"/>

    <div t:if="{{ referencedMessage }}" class="referencedMessage">
        <ReferencedMessage body="{{ referencedMessage.body }}" sender="{{ referencedMessage.sender }}"/>
    </div>

    <span t:if="{{ body.type == 'location' }}" class="thumbnail location">
        <Thumbnail location="{{ body.location }}" gradients="{{darkenMenuArea | then: 'top-right'}}"/>
    </span>
    <span t:else-if="{{ body.type == 'file' and body.hasThumbnail }}" class="thumbnail {{ body.file.type }} {{body.thumbnailError | then: 'has-error'}}">
        <Thumbnail file="{{ body.file }}" gradients="{{darkenMenuArea | then: 'top-right'}}"/>
    </span>

    <t:set t:if="{{ body.type == 'file' }}" filetype="{{ body.file.type }}"/>

    <div t:if="{{ body.type != 'file' or body.isVoiceMessage == false or body.thumbnailError == true }}"
         class="text timestamp-float-{{ floatTimestamp }} {{ hasTimestamp | then: 'has-timestamp' }}">
        <span t:if="{{ isLongEmailMessage }}">
            <small><i><Icon type="email" /> {{ strings.MESSAGE_SENT_VIA_EMAIL }}</i></small><br/><br/>
        </span>
        <span t:if="{{ body.type == 'location' }}" class="message-text">
            <a href="https://maps.google.com/maps?q={{ body.location }}" target="_blank" rel="noopener">
                https://maps.google.com/maps?q={{ body.location }}
            </a>
        </span>
        <span t:if="{{ body.type == 'file' }}" class="message-text">
            <a class="download-link" href="{{ body.file.url }}" target="_blank" rel="noopener noreferrer">
                <Icon type="download"/>
                <span t:if="{{ body.isVoiceMessage == false }}">{{ body.file.formattedFilename }}</span>
                <span t:else><Icon type="microphone" /> {{ strings.VOICE_MESSAGE }} ({{ body.recordingDuration | format_duration }})</span>
            </a>
            <span class="filesize"> ({{ body.file.size | filesize }})</span>
        </span>

        <span t:if="{{ body.type == 'text' }}" class="message-text">
            {{ body.formattedText }}
            <LinkPreviews links="{{ body.links }}" compact="{{ false }}" />
        </span>

        <div t:if="{{ hasTimestamp == false }}" class="typing-indicator">
            <TypingIndicator/>
        </div>
        <span t:if="{{ hasTimestamp }}" class="timestamp timestamp-float">
            <TimeAgo timestamp="{{ timestamp }}"/>
            <span t:if="{{ showStatus }}">&nbsp;<StatusTicks/></span>
        </span>
    </div>


</template>
<style scoped>

.text {
    padding: 0.25rem .5rem;
    white-space: pre-wrap;
}

/* Chat bubbles (UserMessage passes floatTimestamp="auto") sit the timestamp and
   ticks ON the last line of the message, hugging the bubble's right edge — the
   way the site's previous chat theme read. The min-width keeps a one-word
   message ("ok") wide enough that the timestamp still fits on that line instead
   of being pushed onto its own. System messages pass "right" and are untouched.
   Scoped to bodies that actually render a timestamp: the timestamp span is the
   t:else of the typing-indicator branch, so a typing bubble has none, and
   without this `has-timestamp` gate it would reserve the 80px min-width and
   come out wider than the animated dots need. */
.text.timestamp-float-auto.has-timestamp {
    min-width: 5rem;
}
.text a {
    color: currentColor;
}

.timestamp-float-never .message-text {
    display: block;
}

.timestamp {
    font-size: 75%;
    line-height: 2.2; /* aligns the timestamp with the message text */
}

.timestamp-float {
    float: right;
    margin-left: 1.5rem;
    margin-top: 1.5rem;
    opacity: 100%;
}

/* Deliberately AFTER the base rule above, not before it: this override already
   wins on specificity, but relying on that alone means a future simplification
   that drops `.text` from the selector silently restores `margin-top: 1.5rem`,
   which is what pushed the timestamp off the text line in the first place.
   The float is what puts the timestamp on the last line and right-aligns it,
   and it is also why text can never collide with it: a float reserves its own
   space in the line box, so the text wraps around it rather than under it.
   `line-height` matches the MESSAGE TEXT's line box (16px * 1.6 = 25.6px), not
   the timestamp's own 12px font — a float is positioned against the top of the
   current line box, so a short box would ride high above the text baseline.
   Matching the text's line height is what lands it ON the line.
   `white-space: nowrap` keeps a longer relative time ("about 2 months") plus
   the read ticks from wrapping into a second line inside the float. */
.text.timestamp-float-auto > .timestamp-float {
    float: right;
    /* The right margin is on top of .text's own 0.5rem padding: the ticks are a
       tall narrow glyph with almost no side bearing, so at the padding edge
       alone they read as touching the bubble. */
    margin: 0 0.25rem 0 1.5rem;
    line-height: 1.6rem;
    white-space: nowrap;
}

.timestamp-overlay {
    position: absolute;
    right: 1rem;
    bottom: 0.5rem;
    color: #D4D4D4;
}

.thumbnail {
    display: block;
    min-height: 100px;
    max-height: 500px;
    padding: .5rem .5rem 0;
    margin-bottom: 1rem;
}
.thumbnail img {
    border-radius: .25rem;
}

.thumbnail.audio {
    height: auto;
}
.thumbnail.audio.has-error {
    padding: 0.5rem;
}

.thumbnail.location {
    height: 200px;
}

.download-link {
    word-break: break-all;
    text-decoration: none;
}

.download-link span {
    text-decoration: underline;
}

.filesize {
    white-space: nowrap;
    font-size: 75%;
}
</style>
