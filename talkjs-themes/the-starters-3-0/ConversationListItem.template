<!--
Renders the header at the top of the chatbox panel.
-->
<template>

  <t:set names="{{ conversation.otherParticipants | map: 'name' | join: ', ' | default: conversation.me.name }}" />
  <t:set formattedTitle="{{ conversation.formattedSubject | default: names }}" />
  <t:set rawTitle="{{ conversation.rawTitle | default: names }}" />

  <t:set shouldShowAuthor="{{ conversation.isGroupChat and lastMessage.type == 'UserMessage' }}" />

  <ConversationLink title="{{ rawTitle }}" class="conversation-link {{ isActive | then: 'active' }} {{ isUnread | then: 'unread' }}">
    <ConversationImage conversation="{{conversation}}"/>
    <div class="inner">
      <div class="header">
        <div class="conversation-name">{{ formattedTitle }}</div>
        <span class="timestamp"><TimeAgo timestamp="{{lastMessage.timestamp}}" /></span>
      </div>
      <div class="body">
        <div class="message">
          <span class="name" t:if="{{shouldShowAuthor}}">{{lastMessage.sender.name}}: </span>

          <span t:if="{{ lastMessage.body.type == 'text' }}">
            {{lastMessage.body.formattedText}}
          </span>
          <span t:if="{{ lastMessage.body.type == 'location' }}">
            <Icon type="location" /> {{strings.LOCATION}}
          </span>
          <span t:if="{{ lastMessage.body.type == 'file' and lastMessage.body.isVoiceMessage == false }}">
            <Icon type="image" t:if="{{lastMessage.body.file.type == 'image'}}" />
            <Icon type="movie" t:if="{{lastMessage.body.file.type == 'video'}}" />
            <Icon type="attachment" t:if="{{lastMessage.body.file.type == 'other'}}" />
            <span> {{lastMessage.body.file.filename}}</span>
          </span>
          <span t:if="{{ lastMessage.body.type == 'file' and lastMessage.body.isVoiceMessage == true }}">
          <span><Icon type="microphone" /> {{ strings.VOICE_MESSAGE }} ({{ lastMessage.body.recordingDuration | format_duration }})</span>
          </span>
        </div>
        <div t:if="{{ isSearchResult }}">
          <div class="showmsg">
            <Icon type="chevronUp" />
          </div>
        </div>
        <div t:else>
          <div t:if="{{ isUnread and unreadMessageCount == 0 }}" class="unread-generic-dot"></div>
          <div t:if="{{ isUnread and unreadMessageCount > 0 }}" class="unread-dot">
            <span t:if="{{ unreadMessageCount > 999 }}">
              999+
            </span>
            <span t:else-if="{{ unreadMessageCount > 0 }}">
              {{ unreadMessageCount }}
            </span>
          </div>
        </div>
      </div>
    </div>
  </ConversationLink>
</template>
