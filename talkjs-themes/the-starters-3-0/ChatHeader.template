<!--
Renders the header at the top of the chatbox panel.
-->
<template>
  <!-- If you are the only person in the conversation, we want to show your name in the header. Otherwise, show the names of the other participants -->
  <t:set headerParticipants="{{ conversation.otherParticipants.length == 0 | then: conversation.participants | else: conversation.otherParticipants }}" />
  <!-- Clickable Identity is a one-on-one affordance: with exactly one other
       participant the header photo and their name are action buttons carrying
       that member's Memberstack id, which the Messages controller resolves to
       /hire/[slug] at click time. In a group chat (or a conversation with only
       you in it) the photo is a composite and the header stays inert. -->
  <t:set isOneOnOne="{{ conversation.otherParticipants.length == 1 }}" />
  <header class="header">
    <SearchBox t:if="{{ showSearchBox }}" class="search" />
    <div t:else class="inner">
      <div class="content">
        <div class="image">
          <ActionButton t:if="{{ isOneOnOne }}"
            class="identity-photo"
            action="starters-open-profile"
            data-member="{{ conversation.otherParticipants[0].id }}">
            <ConversationImage conversation="{{conversation }}" />
          </ActionButton>
          <ConversationImage t:if="{{ isOneOnOne == false }}" conversation="{{conversation }}" />
        </div>

        <div t:if="{{ conversation.formattedSubject }}" class="info">
          <div class="title">{{ conversation.formattedSubject }}</div>
          <div class="subtitle">	
            <div class="inline-block user {{ presenceEnabled | then: 'presence-enabled' }}" t:for="{{ user in headerParticipants }}" t:key="{{ user.id }}">	
              <ActionButton t:if="{{ isOneOnOne }}"
                class="identity-name"
                action="starters-open-profile"
                data-member="{{ user.id }}">{{user.name}}</ActionButton>
              <span t:if="{{ isOneOnOne == false }}">{{user.name}}</span>
              <StatusIndicator class="status-indicator" user="{{user}}" />	
              <span class="participant-separator" t:if="{{ presenceEnabled == false and forloop.last == false }}">, </span>	
              <span class="company">{{user.custom.company}}</span>
            </div>	
          </div>
        </div>
        <div t:else class="info">
          <div class="title">	
            <div class="inline-block user {{ presenceEnabled | then: 'presence-enabled' }}" t:for="{{ user in headerParticipants }}" t:key="{{ user.id }}">	
              <ActionButton t:if="{{ isOneOnOne }}"
                class="identity-name"
                action="starters-open-profile"
                data-member="{{ user.id }}">{{user.name}}</ActionButton>
              <span t:if="{{ isOneOnOne == false }}">{{user.name}}</span>
              <StatusIndicator class="status-indicator" user="{{user}}" />	
              <span class="participant-separator" t:if="{{ presenceEnabled == false and forloop.last == false }}">, </span>	
              <span class="company">{{user.custom.company}}</span>
            </div>
          </div>
        </div>
      </div>
      <div class="actions">
        <SearchButton t:if="{{ showSearchButton }}" class="action-button">
          <Icon type="search" />
        </SearchButton>
        <ActionMenu t:if="{{ showActionMenu }}" class="action-button">	
          <Icon type="horizontalDots" />	
        </ActionMenu>
        <CloseButton t:if="{{ showCloseButton }}" class="action-button">
          <Icon type="close" />
        </CloseButton>
      </div>
    </div>
  </header>
</template>
