<!--
The `MessageField` component is rendered at the bottom of the chat panel. It includes the text area to write messages, as well as buttons, for example for sending attachments or voice messages.
-->
<template>
    <t:set isNotEditing="{{ isEditing | is_falsy }}" />

    <EmojiPicker t:if="{{ enableEmojiPicker }}" />
    <EmojiSuggestBar class="emoji-suggest-bar" />
    <MentionSuggestList class="mention-suggest-list" />

    <ReplyBar t:if="{{ referencedMessageData }}" messageData="{{ referencedMessageData }}"/>

    <div class="message-field {{ uploadError | then: 'upload-error' }}">
        <VoiceRecorder t:if="{{ recordingState == 'recording' }}" recordingDuration="{{ recordingDuration }}" />

        <RecordingPreview
            t:else-if="{{ recordingState == 'previewing' }}"
            uploadState="{{ uploadState }}"
            audioProgress="{{ audioProgress }}"
            isPlayingAudio="{{ isPlayingAudio }}"
            errorMessage="{{ uploadErrorMessage }}"
        />

        <TextForm t:else-if="{{ recordingState == 'not_recording' and canWrite }}" class="text-form {{ isEditing | then: 'is-editing' }}">
            <div class="text-col">
                <div t:if="{{ atTextLimit }}" class="alert">{{ strings.ENTRYBOX_TEXT_LIMIT }}</div>

                <div class="editor-wrapper">
                    <Editor class="entry-field {{ atTextLimit | then: 'text-limit' }}" />

                    <div class="button-overlay">
                        <LocationButton
                            t:if="{{ canShareLocation and characterCount == 0 }}"
                            class="location-button"
                            ariaLabel="{{ strings.UPLOAD_SHARE_LOCATION }}"
                            title="{{ strings.UPLOAD_SHARE_LOCATION }}"
                        >
                            <Icon type="locationPin" />
                        </LocationButton>

                        <AttachmentButton
                            t:if="{{canShareFile and characterCount == 0 }}"
                            class="attachment-button"
                            ariaLabel="{{ strings.UPLOAD_SEND_FILE }}"
                            title="{{ strings.UPLOAD_SEND_FILE }}"
                        >
                            <Icon type="attach" />
                        </AttachmentButton>

                        <EmojiButton t:if="{{ enableEmojiPicker }}" class="emoji-button" ariaLabel="{{ strings.ARIA_INSERT_EMOJI }}" title="{{ strings.ARIA_INSERT_EMOJI }}">
                            <Icon type="{{ isEmojiPickerOpen | then: 'close' | else: 'emoji' }}" />
                        </EmojiButton>
                    </div>
                </div>
            </div>

            <div t:if="{{ isNotEditing }}" class="send-col {{ characterCount != 0 | then: 'is-typing' }}">
                <VoiceMessageButton t:if="{{ canRecord and characterCount == 0 }}" class="record-button" ariaLabel="{{ strings.VOICE_MESSAGE }}" title="{{ strings.VOICE_MESSAGE }}">
                    <Icon type="mic" />
                </VoiceMessageButton>

                <SendButton t:else class="send-button" ariaLabel="{{ strings.SEND_BUTTON_TEXT }}" title="{{ strings.SEND_BUTTON_TEXT }}">
                    <Icon mirrorWhenRtl type="send" />
                </SendButton>
            </div>

            <!-- Send and Cancel buttons when editing a message -->
            <div t:if="{{ isEditing }}" class="message-actions">
                <div class="send-col">
                    <CancelButton class="cancel-button-full" title="{{ strings.CANCEL }}">{{ strings.CANCEL }}</CancelButton>

                    <t:set sendMessage="{{ canDelete and characterCount == 0 | then: strings.DELETE_MESSAGE | else: strings.SAVE }}" />
                    <SendButton class="send-button-full" title="{{ sendMessage }}">{{ sendMessage }}</SendButton>
                </div>
            </div>
        </TextForm>

        <!-- This section displays a disabled version of the MessageField when the user's permission doesn't allow them to type -->
        <div t:else>
            <Editor disabled="" class="entry-field disabled" />
        </div>
    </div>
</template>
